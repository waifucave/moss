<?xml version="1.0" encoding="utf-8"?>
<!-- The link to the person's computer is QUIC over UDP (and HTTPS to a relay when one is used); the network state lets the
     client re-dial at once after a change. No other permission: nothing here asks for a fingerprint, a face or the device
     credential, and the store's key needs none. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
</manifest>
