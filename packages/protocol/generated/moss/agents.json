{
  "area": "agents",
  "owner": "K",
  "methods": {
    "agent.backends": {
      "doc": "The agent backends plugins contribute, with what each computer has (§5.3, §9.3).",
      "owner": "K",
      "direction": "to-daemon",
      "roles": [
        "app",
        "cli"
      ],
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {}
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "backends": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "name": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "en": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "en"
                      ],
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  ]
                },
                "pluginId": {
                  "type": "string",
                  "maxLength": 81,
                  "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\/[a-z][a-z0-9]*(-[a-z0-9]+)*)?$"
                },
                "icon": {
                  "type": "object",
                  "properties": {
                    "mediaType": {
                      "type": "string",
                      "enum": [
                        "image/png",
                        "image/svg+xml"
                      ]
                    },
                    "data": {
                      "type": "string",
                      "maxLength": 87384
                    },
                    "at": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9007199254740991
                    }
                  },
                  "required": [
                    "mediaType",
                    "data",
                    "at"
                  ],
                  "additionalProperties": false
                },
                "color": {
                  "type": "string",
                  "pattern": "^#[0-9a-f]{6}$"
                },
                "color2": {
                  "type": "string",
                  "pattern": "^#[0-9a-f]{6}$"
                },
                "protocol": {
                  "type": "string",
                  "enum": [
                    "acp",
                    "cloud"
                  ]
                },
                "placement": {
                  "type": "string",
                  "enum": [
                    "local",
                    "cloud"
                  ]
                },
                "userStartable": {
                  "default": true,
                  "type": "boolean"
                },
                "computers": {
                  "maxItems": 256,
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "computer": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 63,
                        "pattern": "^[A-Za-z0-9]+(-[A-Za-z0-9]+)*$"
                      },
                      "installed": {
                        "type": "boolean"
                      },
                      "version": {
                        "type": "string",
                        "maxLength": 64
                      },
                      "sandboxed": {
                        "type": "boolean"
                      },
                      "marks": {
                        "maxItems": 16,
                        "type": "array",
                        "items": {
                          "type": "string",
                          "enum": [
                            "stores-plain-text",
                            "passes-environment",
                            "no-deny-list",
                            "unsandboxed",
                            "unasked-actions",
                            "persists-model-choice"
                          ]
                        }
                      }
                    },
                    "required": [
                      "computer",
                      "installed",
                      "marks"
                    ],
                    "additionalProperties": false
                  }
                }
              },
              "required": [
                "id",
                "name",
                "pluginId",
                "protocol",
                "placement",
                "userStartable",
                "computers"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "backends"
        ],
        "additionalProperties": false
      }
    },
    "agent.definitions": {
      "doc": "Agent definitions from plugins, the presets `Agent` offers.",
      "owner": "K",
      "direction": "to-daemon",
      "roles": [
        "app",
        "cli"
      ],
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {}
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "definitions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128
                },
                "name": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "en": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "en"
                      ],
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  ]
                },
                "pluginId": {
                  "type": "string",
                  "maxLength": 81,
                  "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\/[a-z][a-z0-9]*(-[a-z0-9]+)*)?$"
                },
                "backend": {
                  "type": "string",
                  "maxLength": 128
                },
                "model": {
                  "type": "string",
                  "maxLength": 200
                },
                "effort": {
                  "type": "string",
                  "maxLength": 32
                },
                "computer": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 63,
                  "pattern": "^[A-Za-z0-9]+(-[A-Za-z0-9]+)*$"
                },
                "root": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^(home|bots)(\\/|$)"
                }
              },
              "required": [
                "id",
                "name",
                "pluginId",
                "backend"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "definitions"
        ],
        "additionalProperties": false
      }
    },
    "agent.start": {
      "doc": "Starts a coding session the user drives directly, with no bot (`moss code`, §9.3). From a plugin part (`sessions.start`, the app's door) it takes the model, the effort and a first message too (§9.5).",
      "owner": "K",
      "direction": "to-daemon",
      "roles": [
        "app",
        "cli"
      ],
      "userOnly": true,
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "backend": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "computer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[A-Za-z0-9]+(-[A-Za-z0-9]+)*$"
          },
          "root": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096,
            "pattern": "^(home|bots)(\\/|$)"
          },
          "model": {
            "type": "string",
            "maxLength": 200
          },
          "effort": {
            "type": "string",
            "maxLength": 32
          },
          "definition": {
            "type": "string",
            "maxLength": 128
          },
          "prompt": {
            "type": "string",
            "maxLength": 1000000
          }
        },
        "required": [
          "backend",
          "computer",
          "root"
        ]
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "session": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          }
        },
        "required": [
          "session"
        ],
        "additionalProperties": false
      }
    },
    "agent.options": {
      "doc": "What a backend offers to start with, before any session exists: its models with their efforts and its defaults, or that they are unknown until it starts (§9.5).",
      "owner": "CA",
      "direction": "to-daemon",
      "roles": [
        "app",
        "cli"
      ],
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "backend": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "computer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[A-Za-z0-9]+(-[A-Za-z0-9]+)*$"
          }
        },
        "required": [
          "backend"
        ]
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "backend": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "known": {
            "type": "boolean"
          },
          "source": {
            "type": "string",
            "enum": [
              "catalog",
              "quirks",
              "probe",
              "unknown"
            ]
          },
          "models": {
            "maxItems": 1000,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "name": {
                  "anyOf": [
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "en": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "en"
                      ],
                      "additionalProperties": {
                        "type": "string"
                      }
                    }
                  ]
                },
                "efforts": {
                  "maxItems": 16,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 32
                  }
                },
                "defaultEffort": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                }
              },
              "required": [
                "id",
                "name",
                "efforts"
              ],
              "additionalProperties": false
            }
          },
          "efforts": {
            "maxItems": 16,
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 32
            }
          },
          "default": {
            "type": "object",
            "properties": {
              "model": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "effort": {
                "type": "string",
                "minLength": 1,
                "maxLength": 32
              }
            },
            "additionalProperties": false
          }
        },
        "required": [
          "backend",
          "known",
          "source",
          "models"
        ],
        "additionalProperties": false
      }
    },
    "agent.recent": {
      "doc": "The person's last start: backend, model, effort and the folders started in last (tree paths, for the app's main process and the CLI only; a page gets a pick token) (§9.5).",
      "owner": "CA",
      "direction": "to-daemon",
      "roles": [
        "app",
        "cli"
      ],
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {}
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "backend": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "model": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "effort": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "computer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[A-Za-z0-9]+(-[A-Za-z0-9]+)*$"
          },
          "roots": {
            "maxItems": 8,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "root": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 4096,
                  "pattern": "^(home|bots)(\\/|$)"
                },
                "at": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "root",
                "at"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "roots"
        ],
        "additionalProperties": false
      }
    },
    "codeAgent.open": {
      "doc": "Opens a coding session the user drives from an outside ACP client, bound to this connection (§9.3).",
      "owner": "K",
      "direction": "to-daemon",
      "roles": [
        "cli"
      ],
      "userOnly": true,
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "cwd": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "model": {
            "type": "string",
            "maxLength": 200
          },
          "effort": {
            "type": "string",
            "maxLength": 32
          }
        },
        "required": [
          "cwd"
        ]
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "session": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "pattern": "^[A-Za-z0-9._:-]+$"
          }
        },
        "required": [
          "session"
        ],
        "additionalProperties": false
      }
    },
    "codeAgent.send": {
      "doc": "One ACP line from the outside client to the coding agent of this connection's session.",
      "owner": "K",
      "direction": "to-daemon",
      "roles": [
        "cli"
      ],
      "userOnly": true,
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "line": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2097152
          }
        },
        "required": [
          "line"
        ]
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    },
    "bridge.tools": {
      "doc": "The plugin tools in this agent's scope, plus `SendMessage` and `Glossary`, and the instructions the bridge sends as its own.",
      "owner": "K",
      "direction": "to-daemon",
      "roles": [
        "bridge"
      ],
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {}
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "tools": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 64
                },
                "description": {
                  "type": "string",
                  "maxLength": 10000
                },
                "inputSchema": {
                  "type": "object",
                  "propertyNames": {
                    "type": "string"
                  },
                  "additionalProperties": {}
                }
              },
              "required": [
                "name",
                "description",
                "inputSchema"
              ],
              "additionalProperties": false
            }
          },
          "instructions": {
            "type": "string",
            "maxLength": 64000
          }
        },
        "required": [
          "tools",
          "instructions"
        ],
        "additionalProperties": false
      }
    },
    "bridge.call": {
      "doc": "Runs a bridged tool wherever it actually runs, under the same approval rules (§9.3).",
      "owner": "K",
      "direction": "to-daemon",
      "roles": [
        "bridge"
      ],
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "callId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "tool": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "input": {}
        },
        "required": [
          "callId",
          "tool",
          "input"
        ]
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "content": {
            "type": "array",
            "items": {}
          },
          "isError": {
            "type": "boolean"
          }
        },
        "required": [
          "content",
          "isError"
        ],
        "additionalProperties": false
      }
    },
    "bridge.sendMessage": {
      "doc": "The agent messages its bot or another session it may reach (§9.3, §9.5); it folds in like any session's message.",
      "owner": "K",
      "direction": "to-daemon",
      "roles": [
        "bridge"
      ],
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000000
          },
          "to": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "text"
        ]
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "const": true
          }
        },
        "required": [
          "ok"
        ],
        "additionalProperties": false
      }
    },
    "bridge.listSessions": {
      "doc": "The sessions this agent's session may message now (`ListSessions`): exactly those `SendMessage` would deliver to (§9.5).",
      "owner": "CM",
      "direction": "to-daemon",
      "roles": [
        "bridge"
      ],
      "params": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {}
      },
      "result": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "sessions": {
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9._:-]+$"
                },
                "kind": {
                  "type": "string",
                  "enum": [
                    "bot",
                    "side-thread",
                    "agent",
                    "coding"
                  ]
                },
                "title": {
                  "type": "string",
                  "maxLength": 200
                },
                "status": {
                  "type": "string",
                  "enum": [
                    "starting",
                    "ready",
                    "prompting",
                    "cancelling",
                    "idle",
                    "stopped",
                    "failed"
                  ]
                },
                "backend": {
                  "type": "string",
                  "maxLength": 128
                },
                "bot": {
                  "type": "string",
                  "maxLength": 81,
                  "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\/[a-z][a-z0-9]*(-[a-z0-9]+)*)?$"
                },
                "parent": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 128,
                  "pattern": "^[A-Za-z0-9._:-]+$"
                },
                "startedBy": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "user"
                        }
                      },
                      "required": [
                        "kind"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "bot"
                        },
                        "bot": {
                          "type": "string",
                          "maxLength": 81,
                          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\/[a-z][a-z0-9]*(-[a-z0-9]+)*)?$"
                        },
                        "session": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[A-Za-z0-9._:-]+$"
                        }
                      },
                      "required": [
                        "kind",
                        "bot"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "session"
                        },
                        "session": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128,
                          "pattern": "^[A-Za-z0-9._:-]+$"
                        }
                      },
                      "required": [
                        "kind",
                        "session"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "kind": {
                          "type": "string",
                          "const": "routine"
                        },
                        "routine": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 128
                        },
                        "bot": {
                          "type": "string",
                          "maxLength": 81,
                          "pattern": "^[a-z][a-z0-9]*(-[a-z0-9]+)*(\\/[a-z][a-z0-9]*(-[a-z0-9]+)*)?$"
                        }
                      },
                      "required": [
                        "kind",
                        "routine"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "id",
                "kind",
                "status"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "sessions"
        ],
        "additionalProperties": false
      }
    }
  },
  "events": {
    "agent_backends_changed": {
      "doc": "A backend was added, removed or detected anew; clients re-read `agent.backends`.",
      "owner": "K",
      "scope": "core",
      "roles": [
        "app",
        "cli"
      ],
      "schema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "const": "agent_backends_changed"
          },
          "ts": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "type",
          "ts"
        ]
      }
    }
  }
}
