{
  "manifest": 1,
  "name": "Copilot",
  "description": "GitHub Copilot CLI (`copilot --acp`) as an agent bots can delegate to.",
  "engines": {
    "moss": "^1.0.0"
  },
  "contributes": {
    "agentBackends": [
      {
        "id": "copilot",
        "name": "Copilot",
        "protocol": "acp",
        "command": "copilot",
        "args": [
          "--acp"
        ],
        "quirks": "quirks.json",
        "icon": "copilot.svg",
        "color": "#218BFF"
      }
    ]
  }
}
