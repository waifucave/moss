{
  "manifest": 1,
  "name": "Canvas",
  "description": "MOSS Code's start page: every session as a block on a canvas, the lines between them, and on the window's bar how many run and wait and a + for a new session.",
  "engines": {
    "moss": "^1.0.0"
  },
  "client": {
    "entry": "client/index.tsx",
    "css": [
      "client/styles.css"
    ]
  },
  "capabilities": [
    "sessions.read",
    "conversation.read",
    "bots.read",
    "activity.read.bots",
    "computers.read",
    "sessions.start",
    "user.send",
    "shell.control"
  ],
  "settings": {
    "places": {
      "type": "string",
      "title": "Where you moved blocks",
      "description": "Kept by the canvas when you drag a block, so it stays there. Clear it to put every block back in its own place.",
      "default": "",
      "scope": "device",
      "hidden": true
    },
    "seen": {
      "type": "number",
      "title": "When you last saw the canvas",
      "description": "Kept by the canvas so it can mark what crossed between sessions while it was closed.",
      "default": 0,
      "scope": "device",
      "hidden": true
    }
  },
  "contributes": {
    "ui": [
      {
        "spot": "main",
        "key": "start",
        "component": "CanvasStart"
      },
      {
        "spot": "page.bar",
        "key": "start",
        "component": "CanvasBar",
        "title": "Sessions"
      },
      {
        "spot": "session.corner",
        "id": "canvas-corner",
        "component": "CanvasCorner",
        "title": "Show on the canvas",
        "icon": "assets/canvas.svg",
        "when": {
          "session": [
            "coding",
            "agent"
          ]
        }
      }
    ]
  }
}
