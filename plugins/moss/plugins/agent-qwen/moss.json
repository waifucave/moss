{
  "manifest": 1,
  "name": "Qwen",
  "description": "Qwen Code (`qwen --acp`) as an agent bots can delegate to.",
  "engines": {
    "moss": "^1.0.0"
  },
  "contributes": {
    "agentBackends": [
      {
        "id": "qwen",
        "name": "Qwen",
        "protocol": "acp",
        "command": "qwen",
        "args": [
          "--acp"
        ],
        "quirks": "quirks.json",
        "icon": "qwen.svg",
        "color": "#082DFF"
      }
    ]
  }
}
