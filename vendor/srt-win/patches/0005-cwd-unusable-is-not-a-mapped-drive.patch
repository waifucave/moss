 impl std::error::Error for MappedDriveCwd {}
 
+/// Typed error for [`spawn_runner`] when seclogon refused the working directory (`ERROR_DIRECTORY`) and
+/// the cwd's drive is NOT a network drive: the sandbox logon could not make this folder current. The
+/// usual reasons are that the folder is not there (removed, or renamed away), or that the sandbox account
+/// has no right to enter it or one of its parents (an ACL, a deny entry). It used to be reported as
+/// [`MappedDriveCwd`] whatever the drive was, which told a person with a local folder that their drive
+/// was remote.
+#[derive(Debug)]
+pub struct CwdUnusable {
+    /// The working directory as given.
+    pub cwd: String,
+    /// The HRESULT `CreateProcessWithLogonW` failed with.
+    pub hresult: i32,
+    /// Whether the caller's own token sees the cwd as a directory (`Some(false)`: it is not there, or not
+    /// a folder; `None`: it could not be told, e.g. access denied for the caller too).
+    pub exists: Option<bool>,
+    /// `GetDriveTypeW` of the cwd's root (`DRIVE_UNKNOWN` 0, `NO_ROOT_DIR` 1, `REMOVABLE` 2, `FIXED` 3,
+    /// `REMOTE` 4, `CDROM` 5, `RAMDISK` 6), or `None` when the cwd names no drive root.
+    pub drive_type: Option<u32>,
+}
+
+impl std::fmt::Display for CwdUnusable {
+    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {
+        write!(
+            f,
+            "the sandbox account cannot use {} as its working directory (error 0x{:08X}; {}; drive type {}). \
+             The folder may have been removed, or its permissions keep the sandbox account out.",
+            self.cwd,
+            self.hresult as u32,
+            match self.exists {
+                Some(true) => "the folder exists for the caller",
+                Some(false) => "the folder is not there for the caller",
+                None => "the caller could not tell whether the folder exists",
+            },
+            match self.drive_type {
+                Some(t) => t.to_string(),
+                None => "unknown".to_string(),
+            },
+        )
+    }
+}
+
+impl std::error::Error for CwdUnusable {}
+
