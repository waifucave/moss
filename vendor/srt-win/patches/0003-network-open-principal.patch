--- a/src/wfp.rs
+++ b/src/wfp.rs
@@ -359,12 +359,17 @@
 pub(crate) const KIND_PERMIT_PROXY: &str = "permit-loopback-user";
 pub(crate) const KIND_PERMIT_OPEN: &str = "permit-loopback-open";
