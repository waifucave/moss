+/// MOSS patch 0003: the user-keyed BLOCK of the cloud metadata address
+/// alone, in place of `block-user`, for a principal installed with
+/// `--network-open` (a command the person approved to leave the sandbox).
+pub(crate) const KIND_BLOCK_METADATA: &str = "block-metadata";
 
 #[derive(Debug, Clone, Copy, PartialEq, Eq)]
 pub(crate) enum FilterShape {
     PermitLoopback((u16, u16)),
     PermitLoopbackOpen,
     BlockUser,
+    BlockMetadata,
 }
 
 /// One filter of the set, as added at EACH ALE connect layer.
@@ -387,6 +392,13 @@
 /// The filters [`install_filters`] adds at each ALE connect layer.
 /// `allow_loopback` adds exactly one PERMIT and changes nothing else.
 pub(crate) fn filter_specs(proxy_range: (u16, u16), allow_loopback: bool) -> Vec<FilterSpec> {
+    filter_specs_for(proxy_range, allow_loopback, false)
+}
+
+/// [`filter_specs`], and with `network_open` (patch 0003) the BLOCK keyed
+/// to the user matches only the cloud metadata address: the principal
+/// reaches every other address, as an unsandboxed process does.
+pub(crate) fn filter_specs_for(proxy_range: (u16, u16), allow_loopback: bool, network_open: bool) -> Vec<FilterSpec> {
     let mut specs = vec![FilterSpec {
         kind: KIND_PERMIT_PROXY,
         weight: W_LOOPBACK,
@@ -399,10 +411,18 @@
             shape: FilterShape::PermitLoopbackOpen,
         });
     }
-    specs.push(FilterSpec {
-        kind: KIND_BLOCK_USER,
-        weight: W_BLOCK,
-        shape: FilterShape::BlockUser,
+    specs.push(if network_open {
+        FilterSpec {
+            kind: KIND_BLOCK_METADATA,
+            weight: W_BLOCK,
+            shape: FilterShape::BlockMetadata,
+        }
+    } else {
+        FilterSpec {
+            kind: KIND_BLOCK_USER,
+            weight: W_BLOCK,
+            shape: FilterShape::BlockUser,
+        }
     });
     specs
 }
