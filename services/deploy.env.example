# Every name the services deploy reads (scripts/services/deploy.ts, scripts/services/post-deploy.ts).
# Copy this file somewhere OUTSIDE the repository, fill it in, and pass it with --env-file, or export the names.
# Production values never go in this file or in git. Names marked (secret) are put into Cloudflare as secrets by a real
# deploy, over wrangler's standard input; they are never written to disk by the script.
# `bun scripts/services/deploy.ts --generate <kind>` prints a fresh value for the ones marked (generate: kind).
# docs/services-deploy.md explains each one.

# ---- Cloudflare (a real deploy only; read by wrangler, never by a dry run) ----
# CLOUDFLARE_API_TOKEN=     an API token for the account, with Workers edit, and zone DNS edit for the domain below
# CLOUDFLARE_ACCOUNT_ID=    the account's id (Cloudflare dashboard, right side of the Workers page)

# ---- Where everything lives ----
# The domain whose DNS is on the Cloudflare account above. The Workers are put at hooks.<it>, handshake.<it>, push.<it>,
# <web label>.<it> (the web companion; the label is services/web/wrangler.jsonc's) and <it>/auth (accounts). Today's builds of the engine have waifucave.com built in:
# see docs/services-deploy.md before using another.
MOSS_SERVICES_DOMAIN=

# Optional: a host name of its own for one Worker, instead of the default under the domain.
# MOSS_ACCOUNTS_HOST=   (gives accounts a host of its own, with no /auth path)
# MOSS_HOOKS_HOST=
# MOSS_HANDSHAKE_HOST=
# MOSS_PUSH_HOST=
# MOSS_WEB_HOST=

# ---- accounts (services/accounts) ----
# The sign-in project's address and its PUBLIC anon key (the project's settings page, API section). Not secrets.
MOSS_SUPABASE_URL=
MOSS_SUPABASE_ANON_KEY=
# (secret) (generate: signing-jwks) {"keys":[private JWK, ...]} that account tokens are signed with. Keep a copy: losing it
# only signs everyone out, but it must stay stable between deploys.
MOSS_SIGNING_JWKS=

# ---- forwarder (services/forwarder; hooks.<domain>) ----
# (secret) (generate: tag-keys) numbered keys that tag the webhook addresses; rotatable by adding a number.
MOSS_TAG_KEYS=
# (secret) (generate: random) names each account's object. NEVER rotate and never lose: new value = every account's held webhooks unreachable.
MOSS_ACCOUNT_ID_KEY=
# (secret) (generate: random) signs the forwarder's connection tickets; rotatable any time.
MOSS_FORWARDER_TICKET_SECRET=

# ---- handshake (services/handshake; handshake.<domain>) ----
# (secret) (generate: random) signs the handshake's socket tickets (they last a minute); rotatable any time.
MOSS_HANDSHAKE_TICKET_SECRET=

# ---- push (services/push; push.<domain>) ----
# From the Apple developer account: Certificates, Identifiers & Profiles > Keys > a key with "Apple Push Notifications service".
MOSS_APNS_KEY_ID=
MOSS_APNS_TEAM_ID=
# The two iPhone apps' bundle ids (Apple's push topics): MOSS's and MOSS Code's.
MOSS_APNS_TOPIC_MOSS=
MOSS_APNS_TOPIC_CODE=
# (secret) the .p8 file's whole text (PKCS #8 PEM) that Apple lets you download once.
MOSS_APNS_PRIVATE_KEY=
# Web Push (browsers): a P-256 pair made by `--generate vapid` (prints both lines); the public half is not secret.
MOSS_VAPID_PUBLIC_KEY=
# (secret) (generate: vapid)
MOSS_VAPID_PRIVATE_KEY=
# Optional: a contact address the push services may write to; default mailto:push@<domain>.
# MOSS_VAPID_SUBJECT=

# ---- relay (services/relay): each user's own Cloudflare account, not part of the owner's deploy ----
# Only with --only relay, run by the person whose relay it is.
# MOSS_RELAY_ORIGIN=   the address the Worker will have, e.g. its workers.dev address
# MOSS_RELAY_KEY=      (secret) (generate: random) the access key the relay plugin is given
